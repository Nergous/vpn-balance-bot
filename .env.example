# Runtime environment: development, test, or production.
# Production must receive environment variables from the process environment;
# the application refuses to load a local .env file in production.
APP_ENV=development

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram ID of the only administrator.
ADMIN_TELEGRAM_ID=

# SQLite database path. Use a separate path for tests.
DATABASE_PATH=./data/vpn-balance-bot.db

# IANA timezone used for billing dates.
APP_TIMEZONE=Europe/Moscow

# Hour for daily reminders in APP_TIMEZONE.
REMINDER_HOUR=9

# Invite token lifetime.
INVITE_TTL=168h

# debug, info, warn, or error.
LOG_LEVEL=info

# Telegram message language. Russian is the default; English is also supported.
BOT_LANG=ru

# Positive outbound HTTP timeout. Default: 30s.
HTTP_TIMEOUT=30s

# Positive SQLite operation timeout. Default: 30s.
DB_TIMEOUT=30s
